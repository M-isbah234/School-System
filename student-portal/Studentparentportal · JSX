/*  ████████  TEACHER PORTAL                                                  */
/* ═══════════════════════════════════════════════════════════════════════════ */

const TEACHER_NAV = [
  { id:'tdashboard', label:'Dashboard',  Ico:LayoutDashboard },
  { id:'tattendance',label:'Attendance', Ico:CalendarCheck },
  { id:'tmarks',     label:'Marksheet',  Ico:Award },
  { id:'tremarks',   label:'Remarks',    Ico:MessageSquare },
  { id:'thomework',  label:'Homework',   Ico:NotebookPen },
];

function TeacherPortal({ user, onLogout }) {
  const [view, setView]         = useState('tdashboard');
  const [tdata, setTdata]       = useState(null);
  const [loading, setLoading]   = useState(true);
  const [attUpdates, setAttUpd] = useState({});
  const [attSaving, setAttSaving] = useState(false);
  const [attSaved, setAttSaved] = useState(false);
  const [remarkForm, setRF]     = useState({ studentId:'s1', type:'Positive', text:'' });
  const [remarkBusy, setRB]     = useState(false);
  const [remarkDone, setRD]     = useState('');

  useEffect(() => {
    api.getTeacherData(user.id).then(d => { setTdata(d); setLoading(false); });
  }, [user.id]);

  const handleSaveAttendance = async () => {
    setAttSaving(true);
    const updates = Object.entries(attUpdates).map(([studentId, status]) => ({ studentId, status }));
    if (updates.length) {
      const updated = await api.submitAttendance(user.id, updates);
      setTdata(d => ({ ...d, attendanceRecords: updated }));
    }
    setAttUpd({}); setAttSaving(false); setAttSaved(true);
    setTimeout(() => setAttSaved(false), 3000);
  };

  const handleAddRemark = async () => {
    if (!remarkForm.text.trim()) return;
    setRB(true);
    const updated = await api.addRemark(tdata.remarks, user.id, remarkForm);
    setTdata(d => ({ ...d, remarks: updated }));
    setRF({ studentId:'s1', type:'Positive', text:'' });
    setRD('Remark submitted successfully.'); setRB(false);
    setTimeout(() => setRD(''), 3000);
  };

  if (loading || !tdata) return <Loading label="Loading teacher dashboard…" />;

  const allStudents = DB.students.filter(s => DB.users.find(u => u.id===user.id)?.classes?.includes(s.className));

  return (
    <div className="cr" style={{ minHeight:'100vh' }}>
      <Styles />
      <SideNav items={TEACHER_NAV} active={view} onChange={setView} user={user} />
      <main style={{ paddingLeft:0, paddingRight:16, paddingTop:16, paddingBottom:80 }} id="tmain">
        <style>{`@media(min-width:768px){ #tmain{padding-left:252px!important} }`}</style>
        <AppHeader user={user} alertCount={0} notices={DB.notices} onLogout={onLogout} />

        {view === 'tdashboard' && (
          <div className="space-y-4">
            <div className="grid g3 gap-4 md-g1 sm-g1">
              {[
                { label:'My Students', val:allStudents.length, Ico:Users, tint:'t-lav', ic:'var(--acd)' },
                { label:'Marksheets Submitted', val:tdata.marksheets.length, Ico:Award, tint:'t-mint', ic:'var(--ok)' },
                { label:'Homework Assigned', val:tdata.homework.length, Ico:NotebookPen, tint:'t-sky', ic:'#3576C9' },
              ].map(c => (
                <div key={c.label} className={`cc ${c.tint} p5`}>
                  <div className="cw flex items-center justify-center" style={{ width:44, height:44, marginBottom:10 }}><c.Ico size={18} color={c.ic} /></div>
                  <p className="qsand" style={{ fontWeight:700, fontSize:24 }}>{c.val}</p>
                  <p style={{ fontSize:13, color:'var(--soft)', marginTop:4 }}>{c.label}</p>
                </div>
              ))}
            </div>
            <div className="cc p5">
              <SecTitle Ico={ClipboardList} title="My Class Marksheet" sub={`${user.subject} · Grade 9 Crimson`} />
              <div style={{ overflowX:'auto' }}>
                <table style={{ width:'100%', borderCollapse:'separate', borderSpacing:'0 6px', minWidth:360 }}>
                  <thead><tr style={{ color:'var(--soft)', fontSize:12 }}>
                    {['Student','Test','Obtained','Total','%'].map(h => <th key={h} style={{ textAlign:'left', padding:'3px 10px', fontFamily:'Quicksand,sans-serif', fontWeight:700 }}>{h}</th>)}
                  </tr></thead>
                  <tbody>
                    {tdata.marksheets.map((m,i) => {
                      const pct = Math.round(m.obtained/m.total*100);
                      return (
                        <tr key={i} className="crf">
                          <td style={{ padding:'9px 10px', fontWeight:600, fontSize:13 }}>{m.studentName}</td>
                          <td style={{ padding:'9px 10px', fontSize:13 }}>{m.subject}</td>
                          <td style={{ padding:'9px 10px', fontSize:13 }}>{m.obtained}</td>
                          <td style={{ padding:'9px 10px', fontSize:13 }}>{m.total}</td>
                          <td style={{ padding:'9px 10px' }}><span style={{ color:pct>=80?'var(--ok)':pct>=60?'var(--warn)':'var(--err)', fontWeight:700, fontSize:13 }}>{pct}%</span></td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        {view === 'tattendance' && (
          <div className="cc p5">
            <SecTitle Ico={CalendarCheck} title="Mark Attendance" sub={`Today · ${fmtDate(TODAY_STR)}`} />
            <div className="space-y-3">
              {allStudents.map(s => {
                const existing = tdata.attendanceRecords.find(a => a.studentId === s.id);
                const current  = attUpdates[s.id] || existing?.status || 'present';
                return (
                  <div key={s.id} className="cr0 p4" style={{ display:'flex', alignItems:'center', gap:10, flexWrap:'wrap' }}>
                    <div style={{ width:36, height:36, borderRadius:'50%', background:'var(--acc)', color:'#fff', display:'flex', alignItems:'center', justifyContent:'center', fontSize:13, fontWeight:700, fontFamily:'Quicksand,sans-serif', flexShrink:0 }}>
                      {s.name.split(' ').map(n=>n[0]).join('').substring(0,2)}
                    </div>
                    <div style={{ flex:1 }}>
                      <p className="qsand" style={{ fontWeight:700, fontSize:13 }}>{s.name}</p>
                      <p style={{ fontSize:11, color:'var(--soft)' }}>{s.rollNo}</p>
                    </div>
                    <div style={{ display:'flex', gap:6 }}>
                      {['present','absent','leave'].map(st => (
                        <button key={st} className={`chip ${current===st?'on':''}`}
                          style={{ background: current===st ? (st==='present'?'var(--ok)':st==='absent'?'var(--err)':'var(--warn)') : 'var(--surf)', color: current===st ? '#fff' : 'var(--soft)', boxShadow: current===st ? 'var(--shp)' : 'var(--shs)' }}
                          onClick={() => setAttUpd(prev => ({ ...prev, [s.id]: st }))}>
                          {st.charAt(0).toUpperCase()+st.slice(1)}
                        </button>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
            <div style={{ display:'flex', alignItems:'center', gap:10, marginTop:16 }}>
              <Btn ok onClick={handleSaveAttendance} disabled={attSaving}>
                {attSaving ? <Spinner /> : <Check size={14} />}
                {attSaving ? 'Saving…' : 'Submit Attendance'}
              </Btn>
              {attSaved && <span style={{ fontSize:13, color:'var(--ok)', fontWeight:600 }}>✓ Attendance saved!</span>}
            </div>
          </div>
        )}

        {view === 'tmarks' && (
          <div className="cc p5">
            <SecTitle Ico={Award} title="Marksheet" sub="All submitted assessments" />
            <div style={{ overflowX:'auto' }}>
              <table style={{ width:'100%', borderCollapse:'separate', borderSpacing:'0 6px', minWidth:400 }}>
                <thead><tr style={{ color:'var(--soft)', fontSize:12 }}>
                  {['Student','Subject','Test','Marks','%'].map(h => <th key={h} style={{ textAlign:'left', padding:'3px 10px', fontFamily:'Quicksand,sans-serif', fontWeight:700 }}>{h}</th>)}
                </tr></thead>
                <tbody>
                  {tdata.marksheets.map((m,i) => {
                    const pct = Math.round(m.obtained/m.total*100);
                    return (
                      <tr key={i} className="crf">
                        <td style={{ padding:'9px 10px', fontWeight:600, fontSize:13 }}>{m.studentName}</td>
                        <td style={{ padding:'9px 10px', fontSize:13 }}>{m.subject}</td>
                        <td style={{ padding:'9px 10px', fontSize:13 }}>{fmtDate(m.date)}</td>
                        <td style={{ padding:'9px 10px', fontSize:13 }}>{m.obtained}/{m.total}</td>
                        <td style={{ padding:'9px 10px' }}><span style={{ color:pct>=80?'var(--ok)':pct>=60?'var(--warn)':'var(--err)', fontWeight:700, fontSize:13 }}>{pct}%</span></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {view === 'tremarks' && (
          <div className="grid g2 gap-4 md-g1">
            <div className="cc p5">
              <SecTitle Ico={Edit3} title="Add Remark" sub="Post feedback for a student" />
              <div style={{ marginBottom:12 }}>
                <label style={{ fontSize:12, fontWeight:600, color:'var(--soft)', display:'block', marginBottom:5 }}>Student</label>
                <select className="csel" value={remarkForm.studentId} onChange={e => setRF(f => ({ ...f, studentId:e.target.value }))}>
                  {allStudents.map(s => <option key={s.id} value={s.id}>{s.name}</option>)}
                </select>
              </div>
              <div style={{ marginBottom:12 }}>
                <label style={{ fontSize:12, fontWeight:600, color:'var(--soft)', display:'block', marginBottom:5 }}>Remark Type</label>
                <div style={{ display:'flex', gap:6, flexWrap:'wrap' }}>
                  {['Positive','Improvement','Behavior'].map(t => (
                    <button key={t} className={`chip ${remarkForm.type===t?'on':''}`} onClick={() => setRF(f => ({ ...f, type:t }))}>{t}</button>
                  ))}
                </div>
              </div>
              <div style={{ marginBottom:12 }}>
                <label style={{ fontSize:12, fontWeight:600, color:'var(--soft)', display:'block', marginBottom:5 }}>Remark</label>
                <textarea className="ctxt" placeholder="Write your remark or feedback here…" value={remarkForm.text} onChange={e => setRF(f => ({ ...f, text:e.target.value }))} maxLength={400} />
              </div>
              <Btn ok onClick={handleAddRemark} disabled={remarkBusy || !remarkForm.text.trim()}>
                {remarkBusy ? <Spinner /> : <Send size={14} />}
                {remarkBusy ? 'Submitting…' : 'Post Remark'}
              </Btn>
              {remarkDone && <p style={{ fontSize:13, color:'var(--ok)', marginTop:8, fontWeight:600 }}>✓ {remarkDone}</p>}
            </div>
            <div className="cc p5">
              <SecTitle Ico={MessageSquare} title="My Submitted Remarks" sub="Remarks posted by you" />
              <div className="space-y-3">
                {tdata.remarks.filter(r => r.teacherId === user.id).map(r => {
                  const cfg = REMARK_CFG[r.type] || { tint:'t-sky', Ico:MessageSquare, label:r.type };
                  const stu = allStudents.find(s => s.id === r.studentId);
                  return (
                    <div key={r.id} className={`cr0 ${cfg.tint} p4`}>
                      <div style={{ display:'flex', justifyContent:'space-between', flexWrap:'wrap', gap:4, marginBottom:4 }}>
                        <p className="qsand" style={{ fontWeight:700, fontSize:13 }}>{stu?.name || 'Student'}</p>
                        <div style={{ display:'flex', gap:6, alignItems:'center' }}>
                          <span className="badge b-lav">{r.type}</span>
                          {r.acknowledged ? <Badge status="resolved" /> : <Badge status="pending" />}
                        </div>
                      </div>
                      <p style={{ fontSize:12, color:'var(--ink)' }}>{r.text}</p>
                      <p style={{ fontSize:11, color:'var(--soft)', marginTop:5 }}>{fmtDate(r.date)}</p>
                    </div>
                  );
                })}
                {tdata.remarks.filter(r => r.teacherId === user.id).length === 0 && (
                  <p style={{ fontSize:13, color:'var(--soft)', textAlign:'center', padding:20 }}>No remarks posted yet.</p>
                )}
              </div>
            </div>
          </div>
        )}

        {view === 'thomework' && (
          <div className="cc p5">
            <SecTitle Ico={NotebookPen} title="Homework Assigned by You" sub="Tasks you've posted to the class" />
            <div className="space-y-3">
              {tdata.homework.map(hw => (
                <div key={hw.id} className="cr0 p4">
                  <div style={{ display:'flex', alignItems:'flex-start', gap:10 }}>
                    <div className="cw flex items-center justify-center" style={{ width:38, height:38, flexShrink:0 }}>
                      <SIcon subject={hw.subject} size={15} color="var(--acc)" />
                    </div>
                    <div style={{ flex:1 }}>
                      <div style={{ display:'flex', justifyContent:'space-between', flexWrap:'wrap', gap:4 }}>
                        <p className="qsand" style={{ fontWeight:700, fontSize:13 }}>{hw.subject}</p>
                        <p style={{ fontSize:11, color:'var(--soft)' }}>Due: {fmtDate(hw.dueDate)}</p>
                      </div>
                      <p style={{ fontSize:12, color:'var(--soft)', marginTop:4 }}>{hw.description}</p>
                      <div style={{ display:'flex', gap:6, flexWrap:'wrap', marginTop:8 }}>
                        {Object.entries(hw.studentStatuses).map(([sid, st]) => {
                          const stu = DB.students.find(s => s.id === sid);
                          return stu ? <span key={sid} className={`badge ${st==='Submitted'?'b-ok':'b-warn'}`}>{stu.name.split(' ')[0]}: {st}</span> : null;
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </main>
      <BottomNav items={TEACHER_NAV} active={view} onChange={setView} />
    </div>
  );
}

