function NotifPanel({ notices, open, onClose }) {
  const ref = useRef(null);
  useEffect(() => {
    function handle(e) { if (ref.current && !ref.current.contains(e.target)) onClose(); }
    if (open) document.addEventListener('mousedown', handle);
    return () => document.removeEventListener('mousedown', handle);
  }, [open, onClose]);
  if (!open) return null;
  return (
    <div className="notif-panel scr" style={{ maxHeight:360, overflowY:'auto' }} ref={ref}>
      <div style={{ padding:'14px 16px 10px', borderBottom:'1px solid rgba(76,68,109,.1)' }}>
        <p className="qsand" style={{ fontWeight:700, fontSize:14, color:'var(--ink)' }}>Notifications</p>
      </div>
      {notices.slice(0,5).map(n => {
        const cfg = NOTICE_CFG[n.category] || NOTICE_CFG.Admin;
        return (
          <div key={n.id} style={{ padding:'10px 16px', borderBottom:'1px solid rgba(76,68,109,.06)', display:'flex', gap:10, alignItems:'flex-start' }}>
            <cfg.Ico size={15} color={cfg.ic} style={{ flexShrink:0, marginTop:2 }} />
            <div>
              <p style={{ fontSize:12, fontWeight:600, color:'var(--ink)' }}>{n.title}</p>
              <p style={{ fontSize:11, color:'var(--soft)', marginTop:2 }}>{fmtDate(n.date)}</p>
            </div>
          </div>
        );
      })}
    </div>
  );
}

