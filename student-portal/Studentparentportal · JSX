          </div>
          <div style={{ marginBottom:8, position:'relative' }}>
            <label style={{ fontSize:12, fontWeight:600, color:'var(--soft)', display:'block', marginBottom:5 }}>Password</label>
            <input className="cinp" type={showP?'text':'password'} placeholder="••••••••"
