          </div>

          {/* Hint */}
          <div className="crf p3" style={{ marginBottom:16, fontSize:12, color:'var(--soft)', borderRadius:12 }}>
            <strong style={{ color:'var(--ink)' }}>Demo credentials — </strong>{selectedRole.hint} / <strong>{role}123</strong>
          </div>

          {/* Inputs */}
          <div style={{ marginBottom:12 }}>
            <label style={{ fontSize:12, fontWeight:600, color:'var(--soft)', display:'block', marginBottom:5 }}>Email Address</label>
            <input className="cinp" type="email" placeholder={`e.g. ${selectedRole.hint.split(' ')[0]}`}
