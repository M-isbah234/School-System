const TODAY_STR = '2026-06-15';
const TODAY_DATE = new Date(TODAY_STR + 'T00:00:00');

function fmtDate(s) {
  return new Date(s + 'T00:00:00').toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' });
}
function daysUntil(s) {
  return Math.round((new Date(s + 'T00:00:00') - TODAY_DATE) / 86400000);
}
function dueLabel(s) {
  const d = daysUntil(s);
  if (d < 0)  return `${Math.abs(d)}d overdue`;
  if (d === 0) return 'Due today';
  if (d === 1) return 'Due tomorrow';
  return `Due in ${d}d`;
}
function pkr(n) { return `Rs. ${Number(n).toLocaleString('en-PK')}`; }

