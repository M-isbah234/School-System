            {ROLES.map(r => (
              <div key={r.id} className={`role-card ${role===r.id?'chosen':''}`} onClick={() => { setRole(r.id); setEmail(''); setPass(''); setErr(''); }}>
                <r.Ico size={22} color={role===r.id?'var(--acc)':'var(--soft)'} style={{ margin:'0 auto 6px' }} />
                <p style={{ fontSize:11, fontWeight:700, color:role===r.id?'var(--acd)':'var(--soft)' }}>{r.label}</p>
              </div>
