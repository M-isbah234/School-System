// FIX #1: ClayDial — use from-0 fill direction, integer display, proper conic-gradient
function ClayDial({ pct=0, label='', size=130, color='var(--acc)' }) {
  const clamped = Math.max(0, Math.min(100, Math.round(pct)));
  // conic-gradient starts at top (12 o'clock) going clockwise
  const deg = clamped * 3.6;
  return (
    <div className="cw flex items-center justify-center" style={{ width:size, height:size, borderRadius:'50%', padding:8, boxShadow:'var(--sh)', background:'var(--surf)' }}>
      <div style={{ width:'100%', height:'100%', borderRadius:'50%', background:`conic-gradient(from -90deg, ${color} ${deg}deg, rgba(76,68,109,.1) ${deg}deg)` }} className="flex items-center justify-center">
        <div className="cw flex flex-col items-center justify-center" style={{ width:'74%', height:'74%', borderRadius:'50%' }}>
          <span className="qsand" style={{ fontSize: Math.round(size * 0.19), fontWeight:700, color:'var(--ink)', lineHeight:1 }}>{clamped}%</span>
          {label && <span style={{ fontSize: Math.max(9, Math.round(size * 0.09)), color:'var(--soft)', textAlign:'center', padding:'0 4px', lineHeight:1.2, marginTop:2 }}>{label}</span>}
        </div>
      </div>
    </div>
  );
}

