      <LoginScreen onLogin={handleLogin} />
    </div>
  );

  // Role-based routing — Admin overrides all
  if (user.role === 'admin')   return <AdminPortal   user={user} onLogout={handleLogout} />;
  if (user.role === 'teacher') return <TeacherPortal user={user} onLogout={handleLogout} />;
  if (user.role === 'parent')  return <ParentPortal  user={user} onLogout={handleLogout} />;

  return <div className="cr"><Styles /><p style={{ padding:40, color:'var(--err)' }}>Unknown role: {user.role}</p></div>;
}

