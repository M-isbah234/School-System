function badgeClass(status) {
  const k = (status||'').toLowerCase().replace(/\s+/g,'');
  const map = {
    present:'b-ok', submitted:'b-ok', resolved:'b-ok', paid:'b-ok', completed:'b-ok',
    absent:'b-err', unpaid:'b-err',
    leave:'b-warn', pending:'b-warn', overdue:'b-warn',
    upcoming:'b-lav', scheduled:'b-lav', inprogress:'b-lav',
    break:'b-sky',
  };
  return map[k] || 'b-lav';
}
function badgeLabel(status) {
  const map = {
    present:'Present', absent:'Absent', leave:'Leave', upcoming:'Upcoming', break:'Break',
    pending:'Pending', scheduled:'Scheduled', resolved:'Resolved', submitted:'Submitted',
    paid:'Paid', unpaid:'Unpaid', inprogress:'In Progress', completed:'Completed',
  };
  return map[(status||'').toLowerCase().replace(/\s+/g,'')] || status;
}

