/*  GLOBAL STYLES — Claymorphism Design System                                */
/* ═══════════════════════════════════════════════════════════════════════════ */

const CLAY_CSS = `
  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');

  .cr { /* clay-root */
    --bg:   #ECE9F7; --surf: #F6F3FC;
    --lav:  #E4D8FC; --mint: #D9F5E8; --peach:#FFE2CE;
    --sky:  #DCEAFD; --yel:  #FFF3C2; --rose: #FCE0E9;
    --ink:  #3D3759; --soft: #8A84A6;
    --acc:  #8C7CF6; --acd:  #6E5DE0;
    --ok:   #45A685; --okbg: #D9F5E8;
    --warn: #E0954A; --wbg:  #FFF0D6;
    --err:  #E26C6C; --ebg:  #FDE3E3;
    --sh: 7px 7px 16px rgba(76,68,109,.16),-5px -5px 12px rgba(255,255,255,.9);
    --shs: 4px 4px 10px rgba(76,68,109,.14),-3px -3px 8px rgba(255,255,255,.9);
    --shp: inset 4px 4px 8px rgba(76,68,109,.18),inset -4px -4px 8px rgba(255,255,255,.7);
    --shw: inset 4px 4px 10px rgba(76,68,109,.12),inset -4px -4px 8px rgba(255,255,255,.85);
    font-family:'Inter',sans-serif; background:var(--bg); color:var(--ink);
    min-height:100vh;
  }
  .cr *, .cr *::before, .cr *::after { box-sizing:border-box; margin:0; }
  .qsand { font-family:'Quicksand',sans-serif; }

  /* Cards & Surfaces */
  .cc  { border-radius:26px; box-shadow:var(--sh); background:var(--surf); }
  .cw  { border-radius:18px; box-shadow:var(--shw); background:var(--surf); }
  .cr0 { border-radius:20px; box-shadow:var(--shs); background:var(--surf); }
  .crf { border-radius:16px; background:rgba(255,255,255,.55); }

  /* Color Tints */
  .t-lav  { background:var(--lav); }
  .t-mint { background:var(--mint); }
  .t-pch  { background:var(--peach); }
  .t-sky  { background:var(--sky); }
  .t-yel  { background:var(--yel); }
  .t-rose { background:var(--rose); }
  .t-surf { background:var(--surf); }

  /* Buttons */
  .cbtn {
    border-radius:18px; font-family:'Quicksand',sans-serif; font-weight:600;
    box-shadow:var(--shs); border:none; cursor:pointer; color:var(--ink);
    transition:transform .12s ease, box-shadow .12s ease;
    display:inline-flex; align-items:center; gap:6px;
  }
  .cbtn:hover:not(:disabled) { box-shadow:var(--sh); }
  .cbtn:active:not(:disabled) { box-shadow:var(--shp); transform:scale(.96); }
  .cbtn:disabled { opacity:.5; cursor:not-allowed; }
  .cbtn-acc { background:var(--acc); color:#fff; }
  .cbtn-ok  { background:var(--ok);  color:#fff; }
  .cbtn-err { background:var(--err); color:#fff; }
  .cbtn-surf{ background:var(--surf); }

  /* Icon Button */
  .cib {
    border-radius:14px; box-shadow:var(--shs); border:none; cursor:pointer;
    background:var(--surf); color:var(--ink);
    transition:transform .12s ease, box-shadow .12s ease;
    display:inline-flex; align-items:center; justify-content:center;
  }
  .cib:active { box-shadow:var(--shp); transform:scale(.93); }
  .cib.on    { box-shadow:var(--shp); background:var(--acc); color:#fff; }

  /* Chips */
  .chip {
    border-radius:14px; box-shadow:var(--shs); font-family:'Quicksand',sans-serif;
    font-weight:600; font-size:12px; padding:7px 13px;
    display:inline-flex; align-items:center; gap:5px;
    cursor:pointer; border:none; background:var(--surf); color:var(--soft);
    transition:transform .12s ease, box-shadow .12s ease;
  }
  .chip.on  { box-shadow:var(--shp); background:var(--acc); color:#fff; }
  .chip:active { transform:scale(.96); }
  .chip:disabled { opacity:.5; cursor:not-allowed; }

  /* Inputs */
  .cinp, .csel, .ctxt {
    border-radius:14px; border:none; box-shadow:var(--shw); background:var(--surf);
    font-family:'Inter',sans-serif; color:var(--ink); padding:11px 15px;
    outline:none; width:100%; font-size:14px;
  }
  .cinp:focus,.csel:focus,.ctxt:focus {
    box-shadow:var(--shw),0 0 0 3px rgba(140,124,246,.3);
  }
  .ctxt { resize:vertical; min-height:90px; }

  /* Badges */
  .badge {
    font-family:'Quicksand',sans-serif; font-weight:700; font-size:10px;
    letter-spacing:.05em; padding:3px 9px; border-radius:999px;
    display:inline-flex; align-items:center; gap:3px;
    text-transform:uppercase; white-space:nowrap;
  }
  .b-ok   { background:var(--okbg); color:var(--ok); }
  .b-err  { background:var(--ebg);  color:var(--err); }
  .b-warn { background:var(--wbg);  color:var(--warn); }
  .b-lav  { background:var(--lav);  color:var(--acd); }
  .b-sky  { background:var(--sky);  color:#3576C9; }

  /* Progress */
  .pbar-t { border-radius:999px; background:var(--surf); box-shadow:var(--shw); height:9px; overflow:hidden; }
  .pbar-f { height:100%; border-radius:999px; transition:width .5s ease; }

  /* Sidebar Nav */
  .snav { box-shadow:var(--sh); border-radius:28px; background:var(--surf); }
  .sni  {
    border-radius:16px; transition:all .14s ease; cursor:pointer; border:none;
    background:transparent; color:var(--soft); font-family:'Quicksand',sans-serif;
    font-weight:600; font-size:14px; display:flex; align-items:center; gap:10px;
    padding:11px 14px; width:100%; text-align:left;
  }
  .sni:hover { background:rgba(140,124,246,.1); color:var(--ink); }
  .sni.on { background:var(--acc); color:#fff; box-shadow:var(--shs); }

  /* Bottom Nav */
  .bnav { box-shadow:0 -5px 16px rgba(76,68,109,.15); background:var(--surf); border-radius:22px 22px 0 0; }
  .bni  {
    border-radius:14px; border:none; background:transparent; color:var(--soft);
    cursor:pointer; transition:all .14s ease; font-family:'Quicksand',sans-serif;
    font-weight:600; font-size:10px; display:flex; flex-direction:column;
    align-items:center; gap:3px; padding:8px 4px;
  }
  .bni.on { color:var(--acd); background:var(--lav); }

  /* Spinner */
  @keyframes spin { to { transform:rotate(360deg); } }
  .spin {
    width:13px; height:13px; border-radius:50%; display:inline-block;
    border:2px solid rgba(76,68,109,.15); border-top-color:var(--acc);
    animation:spin .7s linear infinite; flex-shrink:0;
  }

  /* Role selector on login */
  .role-card {
    border-radius:22px; box-shadow:var(--shs); background:var(--surf);
    cursor:pointer; border:2.5px solid transparent; padding:20px 16px;
    text-align:center; transition:all .15s ease; font-family:'Quicksand',sans-serif;
  }
  .role-card:hover  { box-shadow:var(--sh); border-color:var(--acc); }
  .role-card.chosen { box-shadow:var(--shp); border-color:var(--acc); background:var(--lav); }

  /* Notification panel */
  .notif-panel {
    position:absolute; top:calc(100% + 8px); right:0; width:300px;
    border-radius:22px; box-shadow:var(--sh); background:var(--surf);
    z-index:200; overflow:hidden;
  }

  /* Scrollbar */
  .scr::-webkit-scrollbar { width:5px; }
  .scr::-webkit-scrollbar-thumb { background:#C9BBFA; border-radius:999px; }

  /* Print */
  @media print {
    .no-print { display:none!important; }
    .print-only { display:block!important; }
    body { background:#fff!important; }
    .cc, .cw, .cr0 { box-shadow:none!important; }
    .ch-grid { display:grid!important; grid-template-columns:1fr 1fr 1fr; gap:12px; }
    .ch-copy { border:1px dashed #aaa!important; page-break-inside:avoid; }
  }
  .print-only { display:none; }

  /* Utility flex/grid helpers (mirror Tailwind used in JSX) */
  .flex { display:flex; } .flex-col { flex-direction:column; }
  .items-center { align-items:center; } .items-start { align-items:flex-start; }
  .justify-center { justify-content:center; } .justify-between { justify-content:space-between; }
  .gap-1{gap:4px}.gap-2{gap:8px}.gap-3{gap:12px}.gap-4{gap:16px}.gap-5{gap:20px}.gap-6{gap:24px}
  .flex-1{flex:1;min-width:0;} .flex-shrink-0{flex-shrink:0;}
  .w-full{width:100%;} .h-full{height:100%;} .relative{position:relative;} .absolute{position:absolute;}
  .overflow-hidden{overflow:hidden;} .overflow-y-auto{overflow-y:auto;}
  .truncate{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .text-center{text-align:center;} .text-right{text-align:right;} .text-left{text-align:left;}
  .flex-wrap{flex-wrap:wrap;}
  .grid{display:grid;}
  .g2{grid-template-columns:repeat(2,1fr);}
  .g3{grid-template-columns:repeat(3,1fr);}
  .g5{grid-template-columns:repeat(5,1fr);}
  @media(max-width:640px){.sm-g1{grid-template-columns:1fr!important;}}
  @media(max-width:900px){.md-g1{grid-template-columns:1fr!important;}.md-g2{grid-template-columns:repeat(2,1fr)!important;}}
  .p2{padding:8px}.p3{padding:12px}.p4{padding:16px}.p5{padding:20px}.p6{padding:24px}
  .px2{padding-left:8px;padding-right:8px} .px3{padding-left:12px;padding-right:12px}
  .px4{padding-left:16px;padding-right:16px} .px5{padding-left:20px;padding-right:20px}
  .py2{padding-top:8px;padding-bottom:8px} .py3{padding-top:12px;padding-bottom:12px}
  .mt1{margin-top:4px}.mt2{margin-top:8px}.mt3{margin-top:12px}.mt4{margin-top:16px}
  .mb2{margin-bottom:8px}.mb3{margin-bottom:12px}.mb4{margin-bottom:16px}
  .space-y-3>*+*{margin-top:12px} .space-y-4>*+*{margin-top:16px} .space-y-5>*+*{margin-top:20px}
  .rounded-full{border-radius:9999px;}
  .opacity-60{opacity:.6;}
  .pointer{cursor:pointer;}
  .border-t{border-top:1px solid rgba(76,68,109,.13);}
  .min-w-0{min-width:0;}
  .inline-flex{display:inline-flex;}
`;

function Styles() {
  return <style dangerouslySetInnerHTML={{ __html: CLAY_CSS }} />;
}

