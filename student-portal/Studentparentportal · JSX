/*  MOCK API  (async, mirrors Next.js /api routes)                            */
/* ═══════════════════════════════════════════════════════════════════════════ */

const wait = ms => new Promise(r => setTimeout(r, ms));

const api = {
  async login(email, pass) {
    await wait(600);
    const user = DB.users.find(u => u.email === email && u.pass === pass);
    if (!user) throw new Error('Invalid credentials. Please try again.');
    return JSON.parse(JSON.stringify(user));
  },
  async getStudent(id) {
    await wait(200);
    return JSON.parse(JSON.stringify(DB.students.find(s => s.id === id)));
  },
  async getPortalData(studentId) {
    await wait(600);
    return {
      student:           DB.students.find(s => s.id === studentId),
      attendanceSummary: DB.attendanceSummary[studentId],
      weeklyAttendance:  DB.weeklyAttendance[studentId],
      todayTimetable:    DB.todayTimetable,
      academicRecords:   DB.academicRecords.filter(r => r.studentId === studentId),
      courseHub:         DB.courseHub,
      homework:          DB.homework.map(hw => ({ ...hw, myStatus: hw.studentStatuses[studentId] || 'Pending' })),
      notices:           DB.notices,
      remarks:           DB.remarks.filter(r => r.studentId === studentId),
      tickets:           DB.tickets.filter(t => t.studentId === studentId),
      feeLedger:         DB.feeLedger[studentId],
    };
  },
  async toggleHomework(homeworkList, hwId, studentId) {
    await wait(400);
    const hw = DB.homework.find(h => h.id === hwId);
    if (!hw) throw new Error('Homework not found');
    const cur = hw.studentStatuses[studentId] || 'Pending';
    hw.studentStatuses[studentId] = cur === 'Pending' ? 'Submitted' : 'Pending';
    return homeworkList.map(h => h.id === hwId ? { ...h, myStatus: hw.studentStatuses[studentId] } : h);
  },
  async acknowledgeRemark(remarksList, remarkId) {
    await wait(450);
    const idx = DB.remarks.findIndex(r => r.id === remarkId);
    if (idx >= 0) { DB.remarks[idx].acknowledged = true; DB.remarks[idx].acknowledgedOn = '2026-06-15'; }
    return remarksList.map(r => r.id === remarkId ? { ...r, acknowledged:true, acknowledgedOn:'2026-06-15' } : r);
  },
  async createTicket(ticketList, studentId, payload) {
    await wait(700);
    const nextId = Math.max(...DB.tickets.map(t => t.id), 1000) + 1;
    const t = { id:nextId, studentId, ...payload, status:'Pending', date:'2026-06-15', reply:'' };
    DB.tickets.push(t);
    return [t, ...ticketList];
  },
  async getAdminData() {
    await wait(500);
    return {
      stats:    DB.adminStats,
      students: DB.students,
      teachers: DB.users.filter(u => u.role === 'teacher'),
      notices:  DB.notices,
      allTickets: DB.tickets,
    };
  },
  async postNotice(notices, payload, userId) {
    await wait(600);
    const n = { id: Date.now(), ...payload, date:'2026-06-15', postedBy: userId };
    DB.notices.unshift(n);
    return [n, ...notices];
  },
  async getTeacherData(teacherId) {
    await wait(500);
    const myHomework = DB.homework.filter(hw => hw.teacherId === teacherId);
    const myStudents = DB.students.filter(s =>
      DB.users.find(u => u.id === teacherId)?.classes?.includes(s.className)
    );
    return {
      marksheets:         DB.teacherMarksheets[teacherId] || [],
      attendanceRecords:  DB.teacherAttendance[teacherId] || [],
      homework:           myHomework,
      students:           myStudents,
      remarks:            DB.remarks.filter(r => r.teacherId === teacherId),
    };
  },
  async submitAttendance(teacherId, updates) {
    await wait(500);
    if (!DB.teacherAttendance[teacherId]) DB.teacherAttendance[teacherId] = [];
    updates.forEach(u => {
      const existing = DB.teacherAttendance[teacherId].find(a => a.studentId === u.studentId);
      if (existing) existing.status = u.status;
      else DB.teacherAttendance[teacherId].push({ ...u, date:'2026-06-15' });
    });
    return DB.teacherAttendance[teacherId];
  },
  async addRemark(remarksList, teacherId, payload) {
    await wait(500);
    const r = { id: Date.now(), teacherId, ...payload, acknowledged:false, date:'2026-06-15' };
    DB.remarks.push(r);
    return [r, ...remarksList];
  },
  async updateTicketStatus(allTickets, ticketId, status, reply) {
    await wait(400);
    const idx = DB.tickets.findIndex(t => t.id === ticketId);
    if (idx >= 0) { DB.tickets[idx].status = status; DB.tickets[idx].reply = reply; }
    return DB.tickets.map(t => t.id === ticketId ? { ...t, status, reply } : t);
  }
};

