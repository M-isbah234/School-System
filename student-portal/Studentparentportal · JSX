/*  PARENT PORTAL SHELL                                                       */
/* ═══════════════════════════════════════════════════════════════════════════ */

function ParentPortal({ user, onLogout }) {
  const [view, setView]         = useState('dashboard');
  const [data, setData]         = useState(null);
  const [loading, setLoading]   = useState(true);
  const [busyHwIds, setBHW]     = useState(new Set());
  const [busyRmIds, setBRM]     = useState(new Set());
  const [ticketBusy, setTB]     = useState(false);

  useEffect(() => {
    api.getPortalData(user.studentId).then(d => { setData(d); setLoading(false); });
  }, [user.studentId]);

  const alertCount = useMemo(() => {
    if (!data) return 0;
    return data.homework.filter(h=>h.myStatus==='Pending').length
         + data.remarks.filter(r=>!r.acknowledged).length
         + data.notices.filter(n=>n.category==='Urgent').length;
  }, [data]);

  const handleToggleHw = useCallback(async (id) => {
    setBHW(p => new Set(p).add(id));
    const updated = await api.toggleHomework(data.homework, id, user.studentId);
    setData(d => ({ ...d, homework: updated }));
    setBHW(p => { const n=new Set(p); n.delete(id); return n; });
  }, [data, user.studentId]);

  const handleAck = useCallback(async (id) => {
    setBRM(p => new Set(p).add(id));
    const updated = await api.acknowledgeRemark(data.remarks, id);
    setData(d => ({ ...d, remarks: updated }));
    setBRM(p => { const n=new Set(p); n.delete(id); return n; });
  }, [data]);

  const handleTicket = useCallback(async (payload) => {
    setTB(true);
    const updated = await api.createTicket(data.tickets, user.studentId, payload);
    setData(d => ({ ...d, tickets: updated }));
    setTB(false);
  }, [data, user.studentId]);

  if (loading || !data) return <Loading label="Loading your portal…" />;

  return (
    <div className="cr" style={{ minHeight:'100vh' }}>
      <Styles />
      <SideNav items={PARENT_NAV} active={view} onChange={setView} user={user} />
      <main style={{ paddingLeft:0, paddingRight:16, paddingTop:16, paddingBottom:80 }} id="pmain">
        <style>{`@media(min-width:768px){ #pmain{padding-left:252px!important} }`}</style>
        <AppHeader user={user} alertCount={alertCount} notices={data.notices} onLogout={onLogout} />

        {view==='dashboard'     && <ParentDashboard     data={data} onNav={setView} />}
        {view==='attendance'    && <ParentAttendance    data={data} />}
        {view==='academics'     && <ParentAcademics     data={data} />}
        {view==='diary'         && <ParentDiary         data={data} onToggleHw={handleToggleHw} busyIds={busyHwIds} />}
        {view==='communication' && <ParentCommunication data={data} onAck={handleAck} busyRemarks={busyRmIds} onCreateTicket={handleTicket} ticketBusy={ticketBusy} />}
        {view==='fees'          && <ParentFees          data={data} />}
      </main>
      <BottomNav items={PARENT_NAV} active={view} onChange={setView} />
    </div>
  );
}

