            const cfg = REMARK_CFG[r.type] || { tint:'t-sky', Ico:MessageSquare, label:r.type };
            const busy = busyRemarks.has(r.id);
            return (
              <div key={r.id} className={`cr0 ${cfg.tint} p4`}>
                <div style={{ display:'flex', gap:10, alignItems:'flex-start' }}>
                  <div className="cw flex items-center justify-center" style={{ width:38, height:38, flexShrink:0 }}>
                    <cfg.Ico size={15} color="var(--ink)" />
                  </div>
                  <div style={{ flex:1 }}>
                    <div style={{ display:'flex', justifyContent:'space-between', flexWrap:'wrap', gap:4 }}>
                      <p className="qsand" style={{ fontWeight:700, fontSize:13 }}>{r.teacher} · {r.subject}</p>
                      <p style={{ fontSize:11, color:'var(--soft)' }}>{fmtDate(r.date)}</p>
                    </div>
                    <p style={{ fontSize:11, color:'var(--soft)', marginTop:2 }}>{cfg.label}</p>
                    <p style={{ fontSize:13, color:'var(--ink)', marginTop:6 }}>{r.text}</p>
                    <div style={{ marginTop:10 }}>
                      {r.acknowledged
                        ? <span className="chip on"><CheckCircle2 size={12} /> Acknowledged {r.acknowledgedOn ? `· ${fmtDate(r.acknowledgedOn)}` : ''}</span>
                        : <button className="chip" onClick={() => onAck(r.id)} disabled={busy}>
                            {busy ? <Spinner /> : <CheckCircle2 size={12} />}
                            {busy ? 'Signing…' : 'Acknowledge & Sign'}
                          </button>
                      }
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div className="space-y-4">
        {/* Query Desk */}
        <div className="cc p5">
          <SecTitle Ico={Send} title="Query Desk" sub="Submit a formal query or appointment" />
          <div>
            <p className="qsand" style={{ fontSize:11, fontWeight:700, letterSpacing:'.05em', color:'var(--soft)', textTransform:'uppercase', marginBottom:8 }}>Category</p>
            <div style={{ display:'flex', flexWrap:'wrap', gap:6, marginBottom:14 }}>
              {TICKET_CATS.map(c => <button key={c} className={`chip ${cat===c?'on':''}`} onClick={() => setCat(c)}>{c}</button>)}
            </div>
            <div style={{ marginBottom:12 }}>
              <label style={{ fontSize:12, fontWeight:600, color:'var(--soft)', display:'block', marginBottom:5 }}>Subject</label>
              <input className="cinp" placeholder="e.g. Request for extra coaching" value={subj} onChange={e => setSubj(e.target.value)} maxLength={120} />
            </div>
            <div style={{ marginBottom:12 }}>
              <label style={{ fontSize:12, fontWeight:600, color:'var(--soft)', display:'block', marginBottom:5 }}>Message</label>
              <textarea className="ctxt" placeholder="Describe your query in detail…" value={msg} onChange={e => setMsg(e.target.value)} maxLength={500} />
            </div>
            <Btn accent onClick={handleSubmit} disabled={ticketBusy || !subj.trim() || !msg.trim()} style={{ width:'100%', justifyContent:'center' }}>
              {ticketBusy ? <Spinner /> : <Send size={14} />}
              {ticketBusy ? 'Submitting…' : 'Submit Query'}
            </Btn>
            {toast && (
              <div className="cr0 t-mint p3" style={{ marginTop:10, display:'flex', gap:8, alignItems:'center', fontSize:13 }}>
                <CheckCircle2 size={15} color="var(--ok)" /> {toast}
              </div>
            )}
          </div>
        </div>

        {/* Ticket Tracker */}
        <div className="cc p5">
          <SecTitle Ico={ClipboardList} title="My Tickets" sub="Track your submitted queries" />
          <div className="space-y-3">
            {data.tickets.map(t => (
              <div key={t.id} className="cr0 p4">
                <div style={{ display:'flex', justifyContent:'space-between', flexWrap:'wrap', gap:6, marginBottom:6 }}>
                  <span className="badge b-lav">{t.category}</span>
                  <Badge status={t.status} />
                </div>
                <p className="qsand" style={{ fontWeight:700, fontSize:13 }}>{t.subject}</p>
                <p style={{ fontSize:12, color:'var(--soft)', marginTop:4 }}>{t.message}</p>
                {t.reply && (
                  <div className="crf p3" style={{ marginTop:8, borderLeft:'3px solid var(--acc)', paddingLeft:10 }}>
                    <p style={{ fontSize:11, fontWeight:600, color:'var(--acc)' }}>School Response:</p>
                    <p style={{ fontSize:12, color:'var(--ink)', marginTop:2 }}>{t.reply}</p>
                  </div>
                )}
                <p style={{ fontSize:11, color:'var(--soft)', marginTop:6 }}>Ticket #{t.id} · {fmtDate(t.date)}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}

/* ---------- Fees ---------------------------------------------------------- */

function ChallanPrint({ data, fee, onClose }) {
  const totalDue = fee.breakdown.reduce((s,b)=>s+b.amount,0) + (fee.arrears||0);
  const challanNo = `ANG-${data.student.rollNo.replace(/[^A-Z0-9]/gi,'')}-0626`;
  const copies = ['Bank Copy','School Copy','Parent Copy'];

  // FIX #4: Modal rendered in-flow (no position:fixed), uses overflow-y on wrapper
  return (
    <div style={{ position:'fixed', inset:0, zIndex:200, background:'rgba(61,55,89,.55)', display:'flex', alignItems:'center', justifyContent:'center', padding:16 }}>
      <div className="cc" style={{ width:'100%', maxWidth:900, maxHeight:'90vh', overflowY:'auto', padding:24, background:'var(--surf)' }} id="challan-modal">
        {/* Controls */}
        <div className="no-print" style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:20 }}>
          <div>
            <h2 className="qsand" style={{ fontWeight:700, fontSize:18, color:'var(--ink)' }}>Fee Challan</h2>
            <p style={{ fontSize:12, color:'var(--soft)' }}>{fee.month} · #{challanNo}</p>
          </div>
          <div style={{ display:'flex', gap:8 }}>
            <Btn accent onClick={() => window.print()}><Printer size={14} /> Print</Btn>
            <button className="cib" style={{ width:38, height:38 }} onClick={onClose}><X size={16} /></button>
          </div>
        </div>
        {/* 3-part challan grid */}
        <div className="ch-grid" style={{ display:'grid', gridTemplateColumns:'1fr 1fr 1fr', gap:12 }}>
          {copies.map(copy => (
            <div key={copy} className="ch-copy cc p4" style={{ fontSize:11, display:'flex', flexDirection:'column', gap:8, minHeight:380 }}>
              <div style={{ textAlign:'center', borderBottom:'1px solid rgba(76,68,109,.12)', paddingBottom:8 }}>
                <p className="qsand" style={{ fontWeight:700, fontSize:13 }}>{fee.bank?.accountTitle || 'Al-Noor Grammar School'}</p>
                <p style={{ color:'var(--soft)', marginTop:2 }}>Fee Challan · {fee.month}</p>
                <p className="qsand" style={{ fontWeight:700, color:'var(--acc)', marginTop:3 }}>{copy}</p>
              </div>
              <table style={{ width:'100%' }}>
                <tbody>
                  {[['Challan No.',challanNo],['Student',data.student.name],['Class',data.student.className],['Roll No.',data.student.rollNo],['Due Date',fmtDate(fee.dueDate)]].map(([k,v]) => (
                    <tr key={k}><td style={{ color:'var(--soft)', padding:'3px 0' }}>{k}</td><td style={{ textAlign:'right', fontWeight:600, padding:'3px 0' }}>{v}</td></tr>
                  ))}
                </tbody>
              </table>
              <table style={{ width:'100%', borderTop:'1px solid rgba(76,68,109,.1)', paddingTop:4 }}>
                <tbody>
                  {fee.breakdown.map(b => (
                    <tr key={b.label}><td style={{ color:'var(--soft)', padding:'2px 0', fontSize:10 }}>{b.label}</td><td style={{ textAlign:'right', padding:'2px 0' }}>{pkr(b.amount)}</td></tr>
                  ))}
                  {(fee.arrears||0) > 0 && <tr><td style={{ color:'var(--err)', padding:'2px 0' }}>Arrears</td><td style={{ textAlign:'right', color:'var(--err)' }}>{pkr(fee.arrears)}</td></tr>}
                  <tr style={{ borderTop:'1px solid rgba(76,68,109,.1)' }}>
                    <td className="qsand" style={{ fontWeight:700, padding:'5px 0' }}>Total</td>
                    <td className="qsand" style={{ textAlign:'right', fontWeight:700, padding:'5px 0' }}>{pkr(totalDue)}</td>
                  </tr>
                </tbody>
              </table>
              <div style={{ marginTop:'auto', paddingTop:8, borderTop:'1px solid rgba(76,68,109,.1)' }}>
                <p style={{ color:'var(--soft)' }}>{fee.bank?.name}</p>
                <p style={{ color:'var(--soft)' }}>A/C: {fee.bank?.accountNo}</p>
                <p style={{ color:'var(--soft)' }}>{fee.bank?.branch}</p>
                <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:8, marginTop:12, textAlign:'center' }}>
                  <div style={{ borderTop:'1px solid rgba(76,68,109,.2)', paddingTop:4, fontSize:10, color:'var(--soft)' }}>Parent Signature</div>
                  <div style={{ borderTop:'1px solid rgba(76,68,109,.2)', paddingTop:4, fontSize:10, color:'var(--soft)' }}>Bank Stamp</div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <p className="no-print" style={{ fontSize:11, color:'var(--soft)', textAlign:'center', marginTop:14 }}>Three copies (Bank · School · Parent) print on one A4 sheet.</p>
      </div>
    </div>
  );
}

function ParentFees({ data }) {
  const [challanOpen, setChallanOpen] = useState(false);
  const fee = data.feeLedger;
  const totalDue = fee.breakdown.reduce((s,b)=>s+b.amount,0) + (fee.arrears||0);

  return (
    <div className="space-y-4">
      <div className="grid g3 gap-4 md-g1 sm-g1">
        {[
          { tint:'t-pch', label:'Current Dues',   val:pkr(totalDue-(fee.arrears||0)), sub:fee.month,                      lc:'#C2783E' },
          { tint:'t-rose',label:'Arrears',         val:pkr(fee.arrears||0),            sub:'Previous months outstanding',  lc:'#C2585F' },
          { tint:'t-mint',label:'Payment Status',  val:pkr(totalDue),                  sub:`${dueLabel(fee.dueDate)}`,     lc:'#2E8B6E', badge:fee.status },
        ].map(c => (
          <div key={c.label} className={`cc ${c.tint} p5`}>
            <div style={{ display:'flex', justifyContent:'space-between', alignItems:'flex-start' }}>
              <p className="qsand" style={{ fontSize:11, fontWeight:700, textTransform:'uppercase', letterSpacing:'.04em', color:c.lc }}>{c.label}</p>
              {c.badge && <Badge status={c.badge} />}
            </div>
            <p className="qsand" style={{ fontWeight:700, fontSize:22, marginTop:8 }}>{c.val}</p>
            <p style={{ fontSize:11, color:'var(--soft)', marginTop:3 }}>{c.sub}</p>
          </div>
        ))}
      </div>

      <div className="cc p5">
        <SecTitle Ico={Banknote} title="Fee Breakdown" sub={`${fee.month} statement`} />
        <div className="space-y-3">
          {fee.breakdown.map(b => (
            <div key={b.label} className="crf p4" style={{ display:'flex', justifyContent:'space-between' }}>
              <p style={{ fontSize:13, fontWeight:600 }}>{b.label}</p>
              <p className="qsand" style={{ fontWeight:700, fontSize:13 }}>{pkr(b.amount)}</p>
            </div>
          ))}
          {(fee.arrears||0) > 0 && (
            <div className="crf p4" style={{ display:'flex', justifyContent:'space-between', background:'var(--ebg)' }}>
              <p style={{ fontSize:13, fontWeight:600, color:'var(--err)' }}>Arrears</p>
              <p className="qsand" style={{ fontWeight:700, fontSize:13, color:'var(--err)' }}>{pkr(fee.arrears)}</p>
            </div>
          )}
          <div className="cr0 t-lav p4" style={{ display:'flex', justifyContent:'space-between', alignItems:'center' }}>
            <p className="qsand" style={{ fontWeight:700, color:'var(--acd)' }}>Total Payable</p>
            <p className="qsand" style={{ fontWeight:700, fontSize:18, color:'var(--acd)' }}>{pkr(totalDue)}</p>
          </div>
        </div>
        <Btn accent onClick={() => setChallanOpen(true)} style={{ marginTop:14, width:'100%', justifyContent:'center' }}>
          <Download size={14} /> Download Fee Challan
        </Btn>
      </div>

      <div className="cc p5">
        <SecTitle Ico={CreditCard} title="Payment History" sub="Last 5 months" />
        <div style={{ overflowX:'auto' }}>
          <table style={{ width:'100%', borderCollapse:'separate', borderSpacing:'0 6px', minWidth:340 }}>
            <thead><tr style={{ color:'var(--soft)', fontSize:12 }}>
              {['Month','Amount','Paid On','Status'].map(h => <th key={h} style={{ textAlign:'left', padding:'3px 10px', fontFamily:'Quicksand,sans-serif', fontWeight:700 }}>{h}</th>)}
            </tr></thead>
            <tbody>
              {fee.paymentHistory.map(p => (
                <tr key={p.month} className="crf">
                  <td style={{ padding:'9px 10px', fontWeight:600, fontSize:13 }}>{p.month}</td>
                  <td style={{ padding:'9px 10px', fontSize:13 }}>{pkr(p.amount)}</td>
                  <td style={{ padding:'9px 10px', fontSize:13 }}>{fmtDate(p.paidOn)}</td>
                  <td style={{ padding:'9px 10px' }}><Badge status={p.status} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* FIX #4: Challan now rendered conditionally, not through fixed modal that collapses iframe */}
      {challanOpen && <ChallanPrint data={data} fee={fee} onClose={() => setChallanOpen(false)} />}
    </div>
  );
}

