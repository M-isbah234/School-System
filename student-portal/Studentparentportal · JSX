  const [msg, setMsg]   = useState('');
  const [toast, setToast] = useState('');

  // FIX #9: use div + onClick instead of <form> to avoid iframe page reload
  const handleSubmit = async () => {
    if (!subj.trim() || !msg.trim()) return;
    await onCreateTicket({ category:cat, subject:subj.trim(), message:msg.trim() });
    setSubj(''); setMsg(''); setCat('Academic');
    setToast('Your query has been submitted successfully. The school office will respond shortly.');
    setTimeout(() => setToast(''), 4500);
  };

  return (
    <div className="grid g2 gap-4 md-g1 sm-g1">
